{
  "name": "spel-safety-app",
  "version": "1.0.0",
  "description": "SPEL Incident Reporting & Safety Management System — instant email/WhatsApp alerts, investigation (RCA + CAPA) and management dashboard.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server.js",
    "setup": "node scripts/setup.js",
    "qr": "node --disable-warning=ExperimentalWarning scripts/generate-qr.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "mssql-sync": "node --disable-warning=ExperimentalWarning scripts/mssql-sync.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke-test.js"
  },
  "engines": {
    "//": "node:sqlite is still experimental — test before moving to a new major.",
    "node": ">=22.5.0 <25"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "mssql": "^11.0.1",
    "multer": "^2.0.1",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  }
}
