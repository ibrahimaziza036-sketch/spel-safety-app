# ================= SPEL Safety App — Configuration =================
# Copy this file to ".env" and fill in real values, then restart the app.
# (Do NOT commit the real .env file — it has passwords.)

# --- Login / sessions ---
# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Initial admin, created automatically on first run (when no users exist).
ADMIN_USERNAME=admin
# If left blank, a strong random password is generated and printed to the console once.
ADMIN_PASSWORD=change-this-admin-password
# Set true ONLY when serving over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=false
# Number of proxy hops in FRONT of the app (nginx/IIS/etc). Must match reality:
# 0 = direct (ignore X-Forwarded-For), 1 = one reverse proxy. Setting this too
# high would let a client spoof its IP and bypass rate limiting.
TRUST_PROXY_HOPS=0

# --- Server ---
PORT=3000
# Public base URL that phones/browsers use to reach this app.
# On a LAN this is the server PC's IP, e.g. http://192.168.1.50:3000
# Links inside emails/WhatsApp use this, so it MUST be reachable by recipients.
BASE_URL=http://localhost:3000

# --- Management recipients ---
# Comma-separated. These people get every incident alert.
MANAGEMENT_EMAILS=ceo@spelgroup.com,gm.safety@spelgroup.com
# WhatsApp numbers in full international format WITHOUT + or spaces.
# Pakistan example: 923001234567  (92 = country code, then number without leading 0)
MANAGEMENT_WHATSAPP=923001234567,923009876543

# --- Email (SMTP) ---
EMAIL_ENABLED=true
# Office 365 example: smtp.office365.com / 587 / STARTTLS
# Gmail example:      smtp.gmail.com / 587  (use an App Password)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=safety-alerts@spelgroup.com
SMTP_PASS=your-smtp-password-or-app-password
EMAIL_FROM=SPEL Safety Alerts <safety-alerts@spelgroup.com>

# --- WhatsApp (whatsapp-web.js) ---
# When true, the app starts a WhatsApp client. First run: open
# http://<BASE_URL>/admin  and scan the QR with a DEDICATED phone number.
WHATSAPP_ENABLED=true
# Set false on a headless server if a bundled Chromium fails to launch and you
# want to point at a system Chrome instead (then set WHATSAPP_CHROME_PATH).
WHATSAPP_HEADLESS=true
# Optional: absolute path to a Chrome/Chromium executable to use instead of the
# one puppeteer downloads. Leave blank to use the bundled one.
WHATSAPP_CHROME_PATH=

# --- Alerting behaviour ---
# Minimum severity that triggers a WhatsApp message. Email always goes for all.
# One of: Minor | Serious | Major | Fatal
WHATSAPP_MIN_SEVERITY=Minor
# Per-message send timeout, so one unreachable number can't stall other alerts.
WHATSAPP_SEND_TIMEOUT_MS=25000
# If WhatsApp stays down this many minutes, email the admins (needs email ON).
WHATSAPP_DOWN_ALARM_MINUTES=5

# --- Alert queue (protects the WhatsApp number from a spam ban) ---
# How many alerts may be dispatched per window before dispatch pauses.
NOTIFY_MAX_PER_WINDOW=60
NOTIFY_WINDOW_MS=600000
NOTIFY_CONCURRENCY=2
NOTIFY_MAX_ATTEMPTS=5

# --- Abuse control for the PUBLIC report endpoint ---
# Genuine reporting is low-volume; these stop a flood from filling the disk or
# spamming management. Raise if a large site legitimately reports more.
INTAKE_PER_IP_PER_HOUR=20
INTAKE_GLOBAL_PER_HOUR=300
MAX_PHOTO_BYTES=10485760
# Total photo storage allowed. At the cap, reports are still accepted but
# without photos — so the disk (and the database on it) can never fill up.
MAX_UPLOAD_DIR_BYTES=2147483648
MAX_DESCRIPTION_CHARS=5000
MAX_SHORT_FIELD_CHARS=200

# Where incident photos are stored. STRONGLY recommended in production: point
# this at a path on a SEPARATE disk/volume from data/safety.db.
# Example: UPLOAD_DIR=E:\spel-safety-photos
UPLOAD_DIR=

# --- Data retention (0 = keep forever) ---
# Notification/delivery log rows older than this are pruned.
RETENTION_NOTIFICATION_LOG_DAYS=180
# Incident records: 0 keeps them forever (recommended for OHS/compliance).
RETENTION_INCIDENT_DAYS=0
